# Copy this file to ".env" (the setup script does it for you).
# Every value is optional. Without a .env file the project starts in safe production mode
# (DEBUG off), so keep DEBUG=True here for local work.

DEBUG=True
DJANGO_SECRET_KEY=3nfert4dzdmr8577mgcxfc
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Used to build the link inside the password reset email
FRONTEND_URL=http://127.0.0.1:8000

# Redis is used as the "channel layer" (see README).
# Keep USE_REDIS=False if Redis is not installed on your machine.
USE_REDIS=False
REDIS_URL=redis://127.0.0.1:6379
